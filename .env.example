# Copy to .env.local after creating the authorized Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never use NEXT_PUBLIC_ for this key or put a management access token here.
SUPABASE_SECRET_KEY=
# Generate independently with: openssl rand -hex 32
ANALYTICS_SIGNING_SECRET=
# The existing public domain; change this if the canonical domain changes.
NEXT_PUBLIC_SITE_URL=https://paper-press-eight.vercel.app
