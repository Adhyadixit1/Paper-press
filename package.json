{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:vinext": "vinext dev",
    "build:vinext": "vinext build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:database": "node --test tests/database.test.mjs",
    "test:store": "node scripts/check-store.mjs",
    "seed:catalog": "node --env-file=.env.local --import tsx scripts/seed-catalog.ts",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
